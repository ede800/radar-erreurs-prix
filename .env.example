# Copier en .env (jamais commité) puis renseigner au moins un canal d'alerte.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Seuil exclusif du score de confiance pour alerter (défaut 80).
ALERT_MIN_SCORE=80
# Pas d'alerte pour une annonce publiée il y a plus de N minutes (défaut 1440 = 24 h).
ALERT_MAX_AGE_MINUTES=1440
# Optionnel : historique de prix Amazon (API payante) pour la vérification croisée.
KEEPA_API_KEY=
# Daemon : intervalle entre deux cycles (s, minimum 10) et pages d'annonces lues par cycle.
POLL_INTERVAL=20
MAX_ENRICH_PER_CYCLE=15
